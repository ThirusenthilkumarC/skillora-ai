# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB Atlas or local MongoDB)
# Leave blank or set to in-memory to use automatic embedded in-memory fallback
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/skillora-ai?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=skillora_super_secure_jwt_secret_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# AI Provider Configuration (Optional)
# If provided, real AI recommendations and analysis are generated.
# If not provided, Skillora AI seamlessly switches to rule-based career intelligence mode with clear labeling.
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
# Alternative OpenAI configuration:
# AI_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
